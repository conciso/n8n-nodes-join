# Deployment Configuration
# Copy this file to .env and fill in your values

# Staging Deployment
STAGING_DEPLOY_USER=your-username
STAGING_DEPLOY_HOST=staging.example.com
STAGING_DEPLOY_PATH=/path/to/deployment
STAGING_DEPLOY_CONTAINER=n8n

# Production Deployment
PRODUCTION_DEPLOY_USER=your-username
PRODUCTION_DEPLOY_HOST=production.example.com
PRODUCTION_DEPLOY_PATH=/path/to/deployment
PRODUCTION_DEPLOY_CONTAINER=n8n

# NPM Publishing
NPM_TOKEN=your-npm-token
